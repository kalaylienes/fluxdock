{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "FluxDock",
  "version": "1.0.3",
  "identifier": "com.fluxdock.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "FluxDock",
        "width": 300,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kalaylienes/fluxdock/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MzJEQUU0MzgwMTZDNzgKUldSNGJBRTQ1Tm95RmRBZDdBMTc0eWd3eExMQjZQc1VxdGViTXZZUVVJek1ybVVtODB4cnRRQSsK",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "FluxDock",
    "copyright": "Copyright (C) 2026 FluxDock contributors",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/kalaylienes/fluxdock",
    "shortDescription": "Claude Code and Codex CLI usage widget",
    "longDescription": "Shows Claude Code and Codex CLI usage for every limit window your account has, floating above the taskbar or pinned into it.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
